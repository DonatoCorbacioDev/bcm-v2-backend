meta {
  name: Register Org B
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/organizations/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "organizationName": "Bruno Test Org B",
    "adminUsername": "admin.b@bruno-test.local",
    "adminPassword": "BrunoTest#123",
    "adminEmail": "admin.b@bruno-test.local",
    "adminFirstName": "Admin",
    "adminLastName": "OrgB"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("tokenAdminB", res.body.token);
}
