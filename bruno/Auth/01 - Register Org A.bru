meta {
  name: Register Org A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/organizations/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "organizationName": "Bruno Test Org A",
    "adminUsername": "admin.a@bruno-test.local",
    "adminPassword": "BrunoTest#123",
    "adminEmail": "admin.a@bruno-test.local",
    "adminFirstName": "Admin",
    "adminLastName": "OrgA",
    "termsVersion": "2026-10-28",
    "termsAccepted": true,
    "professionalUse": true,
    "onerousClausesApproved": true
  }
}

assert {
  res.status: eq 202
}

script:post-response {
  bru.setVar("registrationIdOrgA", res.body.registrationId);
}
