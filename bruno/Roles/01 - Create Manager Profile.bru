meta {
  name: Create Manager Profile
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/managers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdminA}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Mario",
    "lastName": "Manager",
    "email": "manager.a@bruno-test.local",
    "phoneNumber": null,
    "department": "Test"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("managerIdA", res.body.id);
}
