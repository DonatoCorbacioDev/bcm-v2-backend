<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2: Spring IoC manages bean lifecycle;
         defensive copies of service/repository references are unnecessary. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- SPRING_ENDPOINT: Standard Spring MVC endpoints; access control is
         enforced via Spring Security @PreAuthorize annotations. -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!-- SPRING_CSRF_PROTECTION_DISABLED: This API is stateless and JWT-based;
         CSRF protection is intentionally disabled as documented. -->
    <Match>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>

    <!-- SERVLET_HEADER in JwtAuthenticationFilter: Reading the Authorization
         header is the correct and intentional behaviour for JWT authentication. -->
    <Match>
        <Class name="com.donatodev.bcm_backend.jwt.JwtAuthenticationFilter"/>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>

    <!-- IMPROPER_UNICODE: Normalizer.normalize(NFC) + toUpperCase(Locale.ROOT) is applied before
         every case transformation. FindSecBugs does not track Normalizer as a sanitizer,
         so it reports false positives here. All inputs are validated as enum literals. -->
    <Match>
        <Class name="com.donatodev.bcm_backend.controller.ContractController"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Class name="com.donatodev.bcm_backend.service.ContractService"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Class name="com.donatodev.bcm_backend.service.UserService"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Class name="com.donatodev.bcm_backend.service.SepaPaymentService"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Class name="com.donatodev.bcm_backend.service.ContractImportService"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Class name="com.donatodev.bcm_backend.service.OrganizationService"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Class name="com.donatodev.bcm_backend.service.PdfBoxService"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!-- CRLF_INJECTION_LOGS: the logged string is stripped of CRLF characters
         (String.replaceAll) before reaching the logger. FindSecBugs does not
         track replaceAll as a sanitizer for taint analysis, so these are
         false positives once the value has actually been sanitized. -->
    <Match>
        <Class name="com.donatodev.bcm_backend.service.ContractSchedulerService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.donatodev.bcm_backend.service.MonthlyReporter"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.donatodev.bcm_backend.service.WeeklyDigestService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- PATH_TRAVERSAL_IN in LocalStorageService.resolveWithinRoot(): this IS
         the fix, not the vulnerability — it normalizes the resolved path and
         rejects anything that escapes uploadDir (the standard OWASP-recommended
         containment check). FindSecBugs cannot verify a startsWith() containment
         check as a sanitizer for its taint analysis. -->
    <Match>
        <Class name="com.donatodev.bcm_backend.service.LocalStorageService"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <!-- CRLF_INJECTION_LOGS in MlCacheRefresher: safeMessage() strips CRLF via
         String.replaceAll before the value reaches the logger, identical to
         the already-sanitized pattern in AuditAspect/OcrService/RiskScoreRefresher
         (which FindSecBugs's taint tracker does resolve on its own — this one
         instance it does not, likely an analysis-depth quirk). -->
    <Match>
        <Class name="com.donatodev.bcm_backend.service.MlCacheRefresher"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- CRLF_INJECTION_LOGS in OcrService: same already-sanitized safeMessage()
         pattern as above, on the second log.warn call site in the same method
         (temp file cleanup) — FindSecBugs resolves the first call site on its
         own but not this one, the same analysis-depth quirk noted for
         MlCacheRefresher. -->
    <Match>
        <Class name="com.donatodev.bcm_backend.service.OcrService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- COMMAND_INJECTION in OcrService: ProcessBuilder is used with its
         List<String> constructor (no shell involved, so no metacharacter
         injection is possible regardless of content). Every argument is
         either server config (tesseract-command/language/tessdata-dir, set
         by an admin, not per-request user input) or a JVM-generated temp
         file path — never raw request data. -->
    <Match>
        <Class name="com.donatodev.bcm_backend.service.OcrService"/>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>

    <!-- POTENTIAL_XML_INJECTION in WeeklyDigestService: every user-controlled
         field (org name, contract number, customer name, project name) is
         passed through the local escapeHtml() helper before being appended
         to the HTML email body. FindSecBugs does not recognize a hand-written
         method as a sanitizer for taint analysis. -->
    <Match>
        <Class name="com.donatodev.bcm_backend.service.WeeklyDigestService"/>
        <Bug pattern="POTENTIAL_XML_INJECTION"/>
    </Match>

</FindBugsFilter>
